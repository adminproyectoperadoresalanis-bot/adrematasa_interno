rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAlanisEmail() { return isSignedIn() && request.auth.token.email.matches('.*@alanis[.]com[.]mx'); }
    function usuarioActual() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function esAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && usuarioActual().rol == 'admin';
    }
    function esSupervisorDe(supervisorIdSolicitud) {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioActual().rol == 'supervisor' && request.auth.uid == supervisorIdSolicitud;
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        esAdmin() ||
        esSupervisorDe(resource.data.supervisorId) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && userId == usuarioActual().supervisorId) ||
        resource.data.rol == 'admin'
      );
      allow create: if isSignedIn() && request.auth.uid == userId && isAlanisEmail()
                    && request.resource.data.rol == 'empleado'
                    && request.resource.data.estatus == 'pendiente'
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && esAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.rol == resource.data.rol
                    && request.resource.data.supervisorId == resource.data.supervisorId
                    && request.resource.data.estatus == resource.data.estatus;
      allow update: if isSignedIn() && esSupervisorDe(resource.data.supervisorId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diasVacacionesDisponibles', 'diaDescanso', 'horarioSemanal', 'horasSemanales']);
      allow delete: if false;
    }

    match /solicitudes/{solicitudId} {
      allow read: if isSignedIn() && (
        resource.data.empleadoId == request.auth.uid ||
        esSupervisorDe(resource.data.supervisorId) ||
        esAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.empleadoId == request.auth.uid
        && usuarioActual().estatus == 'activo'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.horas is number
        && request.resource.data.horas > 0;
      allow update: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'pendiente'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.empleadoId == resource.data.empleadoId;
      allow delete: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'pendiente';
      allow update: if isSignedIn()
        && esSupervisorDe(resource.data.supervisorId)
        && resource.data.estatus == 'pendiente'
        && request.resource.data.estatus in ['aprobada', 'rechazada']
        && request.resource.data.empleadoId == resource.data.empleadoId;
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /solicitudesVacaciones/{solicitudId} {
      allow read: if isSignedIn() && (
        resource.data.empleadoId == request.auth.uid ||
        esSupervisorDe(resource.data.supervisorId) ||
        esAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.empleadoId == request.auth.uid
        && usuarioActual().estatus == 'activo'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.diasHabiles is number
        && request.resource.data.diasHabiles > 0
        && request.resource.data.diasHabiles <= usuarioActual().get('diasVacacionesDisponibles', 0);
      allow update: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'pendiente'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.empleadoId == resource.data.empleadoId;
      allow delete: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'pendiente';
      allow update: if isSignedIn()
        && esSupervisorDe(resource.data.supervisorId)
        && resource.data.estatus == 'pendiente'
        && request.resource.data.estatus in ['aprobada', 'rechazada']
        && request.resource.data.empleadoId == resource.data.empleadoId;
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /faltas/{faltaId} {
      allow read: if isSignedIn() && (
        resource.data.empleadoId == request.auth.uid ||
        esSupervisorDe(resource.data.supervisorId) ||
        esAdmin()
      );
      allow create: if esAdmin()
        && request.resource.data.capturadoPor == request.auth.uid
        && request.resource.data.capturadoPorRol == 'admin'
        && request.resource.data.estatus == 'aprobada'
        && request.resource.data.tipo in ['injustificada', 'justificada', 'incapacidad', 'permiso_con_goce', 'permiso_sin_goce'];
      allow create: if isSignedIn()
        && esSupervisorDe(request.resource.data.supervisorId)
        && request.resource.data.capturadoPor == request.auth.uid
        && request.resource.data.capturadoPorRol == 'supervisor'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.tipo in ['injustificada', 'justificada', 'incapacidad', 'permiso_con_goce', 'permiso_sin_goce'];
      allow update, delete: if isSignedIn()
        && resource.data.capturadoPor == request.auth.uid
        && resource.data.estatus == 'pendiente';
      allow update, delete: if esAdmin();
    }

    match /notificaciones/{notifId} {
      allow read: if isSignedIn() && resource.data.destinatarioId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.destinatarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow create: if isSignedIn()
        && request.resource.data.destinatarioId is string
        && request.resource.data.leida == false
        && (
          esAdmin() ||
          esSupervisorDe(get(/databases/$(database)/documents/usuarios/$(request.resource.data.destinatarioId)).data.supervisorId) ||
          (
            request.resource.data.tipo == 'solicitudNueva' &&
            exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
            (
              request.resource.data.destinatarioId == usuarioActual().supervisorId ||
              (
                usuarioActual().get('supervisorId', null) == null &&
                get(/databases/$(database)/documents/usuarios/$(request.resource.data.destinatarioId)).data.rol == 'admin' &&
                get(/databases/$(database)/documents/usuarios/$(request.resource.data.destinatarioId)).data.estatus == 'activo'
              )
            )
          )
        );
      allow delete: if false;
    }

    match /configuracion/{docId} {
      allow read: if isSignedIn();
      allow write: if esAdmin();
    }

    match /numerosEmpleado/{numero} {
      allow read, write: if esAdmin();
    }

    // ------------------------------------------------------------------
    // QR/CFDI — cadena de 3 validaciones (decidida por Ivan, 2026-09-02):
    //   1) Atención al Cliente escanea el CFDI real (origenEscaneo).
    //   2) Alguien de Operaciones MEX (Coordinador/Supervisor/Auxiliar/
    //      Despachador) vuelve a escanear el MISMO CFDI de forma
    //      independiente y lo compara contra lo que registró Atención al
    //      Cliente (validacion2). En el MISMO movimiento asigna al operador
    //      que va a recoger el embarque (operadorAsignado — nuevo,
    //      2026-09-07: obligatorio, no se puede dejar pendiente, y vive
    //      aquí en vez del sistema de asignación de viajes de Alanis
    //      Operadores porque ese todavía está en pruebas).
    //   3) Solo hasta que las dos existen, el Apps Script sincroniza
    //      uuidEsperado/receptorRFCEsperado/operadorAsignado hacia
    //      alanis-operadores — el operador (checkpoints de recepción/
    //      pre-entrega) no encuentra nada contra qué comparar hasta que
    //      las dos validaciones ya pasaron. Por eso estadoSync arranca en
    //      'esperando_validacion2' y solo pasa a 'pendiente' (que es lo
    //      que sincroniza el Apps Script) cuando la validación 2 se
    //      escribe.
    //
    // esValidador1()/esValidador2() usan Área + Puesto reales del catálogo
    // de empleados (los mismos valores que usan Organigrama y Catálogo de
    // empleados: usuarios/{uid}.area, usuarios/{uid}.puesto) — no el "rol"
    // de permisos del sistema. Un admin siempre puede hacer cualquiera de
    // las dos, como respaldo.
    // ------------------------------------------------------------------
    function usuarioActivoValido() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioActual().rol in ['admin', 'supervisor', 'empleado'] && usuarioActual().estatus == 'activo';
    }
    function esValidador1() {
      return usuarioActivoValido() && (
        usuarioActual().rol == 'admin' ||
        usuarioActual().get('area', '') == 'Atención al cliente'
      );
    }
    function esValidador2() {
      return usuarioActivoValido() && (
        usuarioActual().rol == 'admin' ||
        (
          usuarioActual().get('area', '') == 'Operaciones MEX' &&
          usuarioActual().get('puesto', '') in ['Coordinador', 'Supervisor', 'Auxiliar', 'Despachador']
        )
      );
    }
    function esSupervisorOAdmin() {
      return usuarioActivoValido() && usuarioActual().rol in ['admin', 'supervisor'];
    }

    match /verificaciones_cfdi_local/{embarqueId} {
      allow read: if usuarioActivoValido();

      // Validación 1 — Atención al Cliente escanea el CFDI de origen.
      allow create: if esValidador1()
        && request.resource.data.embarqueId == embarqueId
        && request.resource.data.uuidEsperado is string
        && request.resource.data.uuidEsperado.size() > 0
        && request.resource.data.receptorRFCEsperado is string
        && request.resource.data.receptorRFCEsperado.size() > 0
        && request.resource.data.estadoSync == 'esperando_validacion2'
        && request.resource.data.origenEscaneo.escaneadoPor.uid == request.auth.uid
        && request.resource.data.origenEscaneo.timestamp == request.time
        && request.resource.data.origenEscaneo.correccion == null;

      // Corrección de la validación 1 (solo supervisor/admin). Si la
      // validación 2 todavía no existía, el embarque sigue esperándola; si
      // ya existía, se re-sincroniza todo de nuevo con el valor corregido.
      allow update: if esSupervisorOAdmin()
        && resource.data.origenEscaneo != null
        && request.resource.data.embarqueId == resource.data.embarqueId
        && request.resource.data.origenEscaneo.escaneadoPor == resource.data.origenEscaneo.escaneadoPor
        && request.resource.data.uuidEsperado is string
        && request.resource.data.uuidEsperado.size() > 0
        && request.resource.data.receptorRFCEsperado is string
        && request.resource.data.receptorRFCEsperado.size() > 0
        && request.resource.data.estadoSync == (resource.data.get('validacion2', null) == null ? 'esperando_validacion2' : 'pendiente')
        && request.resource.data.origenEscaneo.correccion.por.uid == request.auth.uid
        && request.resource.data.origenEscaneo.correccion.timestamp == request.time
        && request.resource.data.origenEscaneo.correccion.valorAnterior.uuidCfdi == resource.data.uuidEsperado
        && request.resource.data.origenEscaneo.correccion.valorAnterior.rfcReceptor == resource.data.receptorRFCEsperado
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uuidEsperado', 'receptorRFCEsperado', 'origenEscaneo', 'estadoSync']);

      // Validación 2 — alguien de Operaciones vuelve a escanear el mismo
      // CFDI de forma independiente, y en el mismo paso asigna al operador
      // que va a recoger el embarque. Solo se permite una vez (mientras no
      // exista todavía) y solo si la validación 1 ya existe. operadorAsignado
      // es obligatorio (no hay "confirmar sin asignar") y su uid debe
      // corresponder a un operador real y activo del catálogo sincronizado
      // desde Alanis Operadores (operadores_alanis) — así no se puede
      // "inventar" un uid que no existe.
      allow update: if esValidador2()
        && resource.data.origenEscaneo != null
        && resource.data.get('validacion2', null) == null
        && request.resource.data.embarqueId == resource.data.embarqueId
        && request.resource.data.uuidEsperado == resource.data.uuidEsperado
        && request.resource.data.receptorRFCEsperado == resource.data.receptorRFCEsperado
        && request.resource.data.origenEscaneo == resource.data.origenEscaneo
        && request.resource.data.estadoSync == 'pendiente'
        && request.resource.data.validacion2.escaneadoPor.uid == request.auth.uid
        && request.resource.data.validacion2.timestamp == request.time
        && request.resource.data.validacion2.uuidCoincide == (request.resource.data.validacion2.uuidLeido == resource.data.uuidEsperado)
        && request.resource.data.validacion2.rfcCoincide == (request.resource.data.validacion2.rfcLeido == resource.data.receptorRFCEsperado)
        && request.resource.data.operadorAsignado.uid is string
        && request.resource.data.operadorAsignado.uid.size() > 0
        && exists(/databases/$(database)/documents/operadores_alanis/$(request.resource.data.operadorAsignado.uid))
        && request.resource.data.operadorAsignado.nombre is string
        && request.resource.data.operadorAsignado.asignadoPor == request.auth.uid
        && request.resource.data.operadorAsignado.timestamp == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validacion2', 'estadoSync', 'operadorAsignado']);

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // QR interno para embarques SIN factura (2026-09-10, ver
    // escaneoOrigen.js): cuando McCain no adjunta factura (movimiento
    // interno de inventario, confirmado con McCain en junta), Atención al
    // Cliente genera su propio QR — tras confirmar explícitamente que es
    // un caso legítimo, no un dato faltante por error — que sustituye al
    // QR del CFDI en toda la cadena de escaneo (origen, validación 2,
    // checkpoints del operador). Este doc es la referencia DURABLE de ese
    // QR generado: necesaria porque el QR se imprime y se escanea después,
    // posiblemente desde otro dispositivo o sesión del navegador —
    // guardarlo solo en memoria del navegador (lo que se probó primero) se
    // rompe en cuanto cambia el dispositivo o se recarga la página.
    // create-only a propósito: una vez generado un código para un
    // embarque, no se corrige ni se reemplaza aquí — si hiciera falta uno
    // distinto, es un caso nuevo. rfc siempre es el marcador fijo
    // 'SIN-FACTURA' (ver RFC_MARCADOR_SIN_FACTURA en escaneoOrigen.js), no
    // un RFC real.
    // ------------------------------------------------------------------
    match /qr_internos_generados/{embarqueId} {
      allow read: if usuarioActivoValido();
      allow create: if esValidador1()
        && request.resource.data.uuid is string
        && request.resource.data.uuid.size() > 0
        && request.resource.data.rfc == 'SIN-FACTURA'
        && request.resource.data.generadoPor.uid == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    match /verificaciones_cfdi_resultado/{embarqueId} {
      allow read: if usuarioActivoValido();
      allow write: if false;
    }

    match /embarques_pendientes_origen/{embarqueId} {
      allow read: if usuarioActivoValido();
      allow write: if false;
    }

    // Catálogo de operadores de Alanis Operadores (uid, nombre, numero de
    // unidad), sincronizado de solo lectura por el Apps Script cada pocos
    // minutos (nuevo, 2026-09-07) — usado por el selector obligatorio de
    // "operador asignado" en la 2da validación de arriba. Nadie escribe
    // aquí desde el navegador: lo llena el Apps Script con su propia
    // cuenta de servicio, que no pasa por estas reglas.
    match /operadores_alanis/{uid} {
      allow read: if usuarioActivoValido();
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Borrado de prueba — TEMPORAL, solo mientras dure esta fase de
    // pruebas con McCain en pausa (2026-09-08). El botón de admin en
    // ADREMATASA únicamente crea esta solicitud; quien borra de verdad (en
    // los dos proyectos) es el Apps Script, con su propia cuenta de
    // servicio — repositorio_mccain (alanis-operadores) y
    // verificaciones_cfdi_local (aquí) siguen con "allow delete: if false"
    // para cualquier navegador, sin excepción, ni siquiera admin.
    //
    // QUITAR este bloque completo cuando termine la fase de pruebas.
    // ------------------------------------------------------------------
    match /solicitudes_borrado_prueba/{embarqueId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.solicitadoPor == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
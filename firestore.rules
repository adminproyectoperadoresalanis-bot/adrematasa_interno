rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAlanisEmail() { return isSignedIn() && request.auth.token.email.matches('.*@alanis[.]com[.]mx'); }
    function usuarioActual() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function esAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && usuarioActual().rol == 'admin';
    }
    function esSupervisorDe(supervisorIdSolicitud) {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioActual().rol == 'supervisor' && request.auth.uid == supervisorIdSolicitud;
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        esAdmin() ||
        esSupervisorDe(resource.data.supervisorId) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && userId == usuarioActual().supervisorId) ||
        resource.data.rol == 'admin'
      );
      allow create: if isSignedIn() && request.auth.uid == userId && isAlanisEmail()
                    && request.resource.data.rol == 'empleado'
                    && request.resource.data.estatus == 'pendiente'
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && esAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.rol == resource.data.rol
                    && request.resource.data.supervisorId == resource.data.supervisorId
                    && request.resource.data.estatus == resource.data.estatus;
      allow update: if isSignedIn() && esSupervisorDe(resource.data.supervisorId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diasVacacionesDisponibles', 'diaDescanso', 'horarioSemanal', 'horasSemanales']);
      allow delete: if false;
    }

    match /solicitudes/{solicitudId} {
      allow read: if isSignedIn() && (
        resource.data.empleadoId == request.auth.uid ||
        esSupervisorDe(resource.data.supervisorId) ||
        esAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.empleadoId == request.auth.uid
        && usuarioActual().estatus == 'activo'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.horas is number
        && request.resource.data.horas > 0;
      allow update: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'pendiente'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.empleadoId == resource.data.empleadoId;
      allow delete: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'pendiente';
      allow update: if isSignedIn()
        && esSupervisorDe(resource.data.supervisorId)
        && resource.data.estatus == 'pendiente'
        && request.resource.data.estatus in ['aprobada', 'rechazada']
        && request.resource.data.empleadoId == resource.data.empleadoId;

      // Ajuste (unificado, 28 sep 2026): el empleado puede solicitar que se
      // revise de nuevo una solicitud de horas extra ya resuelta (aprobada o
      // rechazada) — por ejemplo si el admin/supervisor se equivocó al
      // resolverla. El admin ya podía regresarla a "pendiente" de forma
      // directa (botón "Revertir a pendiente", sin pedir permiso a nadie —
      // eso sigue igual, ver revertirSolicitud() en aprobaciones.js); esto
      // solo agrega la vía para que el EMPLEADO la solicite y quede en la
      // cola de "Ajustes pendientes" hasta que el admin la resuelva (cubierto
      // por "allow update: if esAdmin();" de abajo, que ya tiene permiso
      // total sobre el documento). Aquí solo se permite escribir el campo
      // ajusteSolicitud; nada más del documento cambia en esta rama.
      // Bloqueado si ya se mandó a nómina.
      allow update: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus in ['aprobada', 'rechazada']
        && resource.data.get('enviadoANominaEn', null) == null
        && request.resource.data.estatus == resource.data.estatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ajusteSolicitud'])
        && (
          // Cancelar su propia solicitud de ajuste mientras siga pendiente.
          (
            resource.data.get('ajusteSolicitud', null) != null &&
            resource.data.ajusteSolicitud.estatus == 'pendiente' &&
            request.resource.data.ajusteSolicitud == null
          ) ||
          // Crear una solicitud de ajuste nueva (o volver a intentar tras un
          // rechazo) — nunca mientras ya haya una pendiente sin resolver.
          (
            (resource.data.get('ajusteSolicitud', null) == null || resource.data.ajusteSolicitud.estatus != 'pendiente') &&
            request.resource.data.ajusteSolicitud.estatus == 'pendiente' &&
            request.resource.data.ajusteSolicitud.tipo == 'revertir' &&
            request.resource.data.ajusteSolicitud.motivo is string
          )
        );

      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /solicitudesVacaciones/{solicitudId} {
      allow read: if isSignedIn() && (
        resource.data.empleadoId == request.auth.uid ||
        esSupervisorDe(resource.data.supervisorId) ||
        esAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.empleadoId == request.auth.uid
        && usuarioActual().estatus == 'activo'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.diasHabiles is number
        && request.resource.data.diasHabiles > 0
        && request.resource.data.diasHabiles <= usuarioActual().get('diasVacacionesDisponibles', 0);
      allow update: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'pendiente'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.empleadoId == resource.data.empleadoId;
      allow delete: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'pendiente';
      allow update: if isSignedIn()
        && esSupervisorDe(resource.data.supervisorId)
        && resource.data.estatus == 'pendiente'
        && request.resource.data.estatus in ['aprobada', 'rechazada']
        && request.resource.data.empleadoId == resource.data.empleadoId;

      // Recorte de vacaciones ya aprobadas (18 sep 2026, pedido de Ivan): el
      // propio empleado puede solicitar reducir una vacación YA APROBADA
      // (nunca ampliarla ni tocar días de en medio) — recortando desde un
      // extremo: conserva fechaInicio o fechaFin igual al original, nunca
      // ambos distintos a la vez. Aquí solo se le permite escribir el campo
      // recorteSolicitud; fechaInicio/fechaFin/diasHabiles del documento NO
      // cambian en esta rama — eso solo lo hace Ivan (esAdmin(), más abajo)
      // al aprobar el recorte, junto con la transacción que le regresa
      // saldo al empleado (ver resolverRecorte() en aprobacionesVacaciones.js).
      // No se permite si el periodo ya se mandó a nómina (enviadoANominaEn):
      // si ya se pagó, ya no hay nada que recortar desde aquí.
      allow update: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'aprobada'
        && resource.data.get('enviadoANominaEn', null) == null
        && request.resource.data.estatus == 'aprobada'
        && request.resource.data.fechaInicio == resource.data.fechaInicio
        && request.resource.data.fechaFin == resource.data.fechaFin
        && request.resource.data.diasHabiles == resource.data.diasHabiles
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recorteSolicitud'])
        && (
          // Cancelar su propia solicitud de recorte mientras siga pendiente.
          (
            resource.data.get('recorteSolicitud', null) != null &&
            resource.data.recorteSolicitud.estatus == 'pendiente' &&
            request.resource.data.recorteSolicitud == null
          ) ||
          // Crear una solicitud de recorte nueva (o volver a intentar tras un
          // rechazo) — nunca mientras ya haya una pendiente sin resolver.
          (
            (resource.data.get('recorteSolicitud', null) == null || resource.data.recorteSolicitud.estatus != 'pendiente') &&
            request.resource.data.recorteSolicitud.estatus == 'pendiente' &&
            request.resource.data.recorteSolicitud.fechaInicioNueva is string &&
            request.resource.data.recorteSolicitud.fechaFinNueva is string &&
            request.resource.data.recorteSolicitud.fechaInicioNueva >= resource.data.fechaInicio &&
            request.resource.data.recorteSolicitud.fechaFinNueva <= resource.data.fechaFin &&
            request.resource.data.recorteSolicitud.fechaInicioNueva <= request.resource.data.recorteSolicitud.fechaFinNueva &&
            (
              request.resource.data.recorteSolicitud.fechaInicioNueva == resource.data.fechaInicio ||
              request.resource.data.recorteSolicitud.fechaFinNueva == resource.data.fechaFin
            ) &&
            request.resource.data.recorteSolicitud.diasHabilesNuevos is number &&
            request.resource.data.recorteSolicitud.diasHabilesNuevos > 0 &&
            request.resource.data.recorteSolicitud.diasHabilesNuevos < resource.data.diasHabiles
          )
        );

      // Ajuste (unificado, 28 sep 2026): generaliza el "recorte" de arriba a
      // dos tipos — 'recorte' (igual que antes: solo puede achicar el rango
      // desde un extremo, nunca ampliarlo) y 'cambioFechas' (fechas
      // completamente nuevas, puede ganar o perder días hábiles frente al
      // rango actual, con tope en el saldo disponible). El campo viejo
      // recorteSolicitud (arriba) se queda intacto para solicitudes ya en
      // vuelo — no se toca ni se migra; este es el campo nuevo que usan las
      // pantallas a partir de ahora. Igual que el recorte viejo: no cambia
      // fechaInicio/fechaFin/diasHabiles aquí, eso solo lo hace el admin al
      // aprobar (ver resolverAjusteVacaciones() en aprobacionesVacaciones.js),
      // junto con la transacción que ajusta el saldo del empleado.
      allow update: if isSignedIn()
        && resource.data.empleadoId == request.auth.uid
        && resource.data.estatus == 'aprobada'
        && resource.data.get('enviadoANominaEn', null) == null
        && request.resource.data.estatus == 'aprobada'
        && request.resource.data.fechaInicio == resource.data.fechaInicio
        && request.resource.data.fechaFin == resource.data.fechaFin
        && request.resource.data.diasHabiles == resource.data.diasHabiles
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ajusteSolicitud'])
        && (
          // Cancelar su propia solicitud de ajuste mientras siga pendiente.
          (
            resource.data.get('ajusteSolicitud', null) != null &&
            resource.data.ajusteSolicitud.estatus == 'pendiente' &&
            request.resource.data.ajusteSolicitud == null
          ) ||
          // Crear una solicitud de ajuste nueva (recorte o cambio de fechas)
          // — nunca mientras ya haya una pendiente sin resolver.
          (
            (resource.data.get('ajusteSolicitud', null) == null || resource.data.ajusteSolicitud.estatus != 'pendiente') &&
            request.resource.data.ajusteSolicitud.estatus == 'pendiente' &&
            request.resource.data.ajusteSolicitud.fechaInicioNueva is string &&
            request.resource.data.ajusteSolicitud.fechaFinNueva is string &&
            request.resource.data.ajusteSolicitud.fechaInicioNueva <= request.resource.data.ajusteSolicitud.fechaFinNueva &&
            request.resource.data.ajusteSolicitud.diasHabilesNuevos is number &&
            request.resource.data.ajusteSolicitud.diasHabilesNuevos > 0 &&
            (
              (
                // tipo 'recorte': mismas reglas que el recorteSolicitud viejo —
                // nunca amplía, siempre dentro del rango ya aprobado,
                // conservando un extremo igual al original.
                request.resource.data.ajusteSolicitud.tipo == 'recorte' &&
                request.resource.data.ajusteSolicitud.fechaInicioNueva >= resource.data.fechaInicio &&
                request.resource.data.ajusteSolicitud.fechaFinNueva <= resource.data.fechaFin &&
                (
                  request.resource.data.ajusteSolicitud.fechaInicioNueva == resource.data.fechaInicio ||
                  request.resource.data.ajusteSolicitud.fechaFinNueva == resource.data.fechaFin
                ) &&
                request.resource.data.ajusteSolicitud.diasHabilesNuevos < resource.data.diasHabiles
              ) ||
              (
                // tipo 'cambioFechas': fechas completamente libres, pero nunca
                // puede pedir más días hábiles de los que le alcanzarían con su
                // saldo actual más los días que liberaría esta vacación al
                // cambiarse (tope suave — el admin puede rechazar igual).
                request.resource.data.ajusteSolicitud.tipo == 'cambioFechas' &&
                request.resource.data.ajusteSolicitud.diasHabilesNuevos <= usuarioActual().get('diasVacacionesDisponibles', 0) + resource.data.diasHabiles
              )
            )
          )
        );

      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /faltas/{faltaId} {
      allow read: if isSignedIn() && (
        resource.data.empleadoId == request.auth.uid ||
        esSupervisorDe(resource.data.supervisorId) ||
        esAdmin()
      );
      allow create: if esAdmin()
        && request.resource.data.capturadoPor == request.auth.uid
        && request.resource.data.capturadoPorRol == 'admin'
        && request.resource.data.estatus == 'aprobada'
        && request.resource.data.tipo in ['injustificada', 'justificada', 'incapacidad', 'permiso_con_goce', 'permiso_sin_goce'];
      allow create: if isSignedIn()
        && esSupervisorDe(request.resource.data.supervisorId)
        && request.resource.data.capturadoPor == request.auth.uid
        && request.resource.data.capturadoPorRol == 'supervisor'
        && request.resource.data.estatus == 'pendiente'
        && request.resource.data.tipo in ['injustificada', 'justificada', 'incapacidad', 'permiso_con_goce', 'permiso_sin_goce'];
      allow update, delete: if isSignedIn()
        && resource.data.capturadoPor == request.auth.uid
        && resource.data.estatus == 'pendiente';
      allow update, delete: if esAdmin();
    }

    match /notificaciones/{notifId} {
      allow read: if isSignedIn() && resource.data.destinatarioId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.destinatarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow create: if isSignedIn()
        && request.resource.data.destinatarioId is string
        && request.resource.data.leida == false
        && (
          esAdmin() ||
          esSupervisorDe(get(/databases/$(database)/documents/usuarios/$(request.resource.data.destinatarioId)).data.supervisorId) ||
          (
            request.resource.data.tipo == 'solicitudNueva' &&
            exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
            (
              request.resource.data.destinatarioId == usuarioActual().supervisorId ||
              (
                usuarioActual().get('supervisorId', null) == null &&
                get(/databases/$(database)/documents/usuarios/$(request.resource.data.destinatarioId)).data.rol == 'admin' &&
                get(/databases/$(database)/documents/usuarios/$(request.resource.data.destinatarioId)).data.estatus == 'activo'
              )
            )
          )
        );
      allow delete: if false;
    }

    match /configuracion/{docId} {
      allow read: if isSignedIn();
      allow write: if esAdmin();
    }

    match /numerosEmpleado/{numero} {
      allow read, write: if esAdmin();
    }

    // ------------------------------------------------------------------
    // QR/CFDI — cadena de 3 validaciones (decidida por Ivan, 2026-09-02):
    //   1) Atención al Cliente escanea el CFDI real (origenEscaneo).
    //   2) Alguien de Operaciones MEX (Coordinador/Supervisor/Auxiliar/
    //      Despachador) vuelve a escanear el MISMO CFDI de forma
    //      independiente y lo compara contra lo que registró Atención al
    //      Cliente (validacion2). En el MISMO movimiento asigna al operador
    //      que va a recoger el embarque (operadorAsignado — nuevo,
    //      2026-09-07: obligatorio, no se puede dejar pendiente, y vive
    //      aquí en vez del sistema de asignación de viajes de Alanis
    //      Operadores porque ese todavía está en pruebas).
    //   3) Solo hasta que las dos existen, el Apps Script sincroniza
    //      uuidEsperado/receptorRFCEsperado/operadorAsignado hacia
    //      alanis-operadores — el operador (checkpoints de recepción/
    //      pre-entrega) no encuentra nada contra qué comparar hasta que
    //      las dos validaciones ya pasaron. Por eso estadoSync arranca en
    //      'esperando_validacion2' y solo pasa a 'pendiente' (que es lo
    //      que sincroniza el Apps Script) cuando la validación 2 se
    //      escribe.
    //
    // esValidador1()/esValidador2() usan Área + Puesto reales del catálogo
    // de empleados (los mismos valores que usan Organigrama y Catálogo de
    // empleados: usuarios/{uid}.area, usuarios/{uid}.puesto) — no el "rol"
    // de permisos del sistema. Un admin siempre puede hacer cualquiera de
    // las dos, como respaldo.
    // ------------------------------------------------------------------
    function usuarioActivoValido() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioActual().rol in ['admin', 'supervisor', 'empleado'] && usuarioActual().estatus == 'activo';
    }
    function esValidador1() {
      return usuarioActivoValido() && (
        usuarioActual().rol == 'admin' ||
        usuarioActual().get('area', '') == 'Atención al cliente'
      );
    }
    function esValidador2() {
      return usuarioActivoValido() && (
        usuarioActual().rol == 'admin' ||
        (
          usuarioActual().get('area', '') == 'Operaciones MEX' &&
          usuarioActual().get('puesto', '') in ['Coordinador', 'Supervisor', 'Auxiliar', 'Despachador']
        )
      );
    }
    function esSupervisorOAdmin() {
      return usuarioActivoValido() && usuarioActual().rol in ['admin', 'supervisor'];
    }

    match /verificaciones_cfdi_local/{embarqueId} {
      allow read: if usuarioActivoValido();

      // Validación 1 — dos casos (segundo caso agregado 2026-09-12):
      //   (a) Atención al Cliente escanea el CFDI real — uuidEsperado y
      //       receptorRFCEsperado ya se conocen desde este mismo create.
      //   (b) Atención al Cliente confirma que el embarque NO trae factura
      //       — uuidEsperado/receptorRFCEsperado todavía NO existen (se
      //       generan hasta que Operaciones cree el QR interno en la
      //       validación 2, ver más abajo); esQrInterno queda marcado
      //       desde aquí para poder distinguir el caso en validación 2.
      allow create: if esValidador1()
        && request.resource.data.embarqueId == embarqueId
        && request.resource.data.estadoSync == 'esperando_validacion2'
        && request.resource.data.origenEscaneo.escaneadoPor.uid == request.auth.uid
        && request.resource.data.origenEscaneo.timestamp == request.time
        && request.resource.data.origenEscaneo.correccion == null
        && (
          (
            request.resource.data.get('esQrInterno', false) == false
            && request.resource.data.uuidEsperado is string
            && request.resource.data.uuidEsperado.size() > 0
            && request.resource.data.receptorRFCEsperado is string
            && request.resource.data.receptorRFCEsperado.size() > 0
          ) ||
          (
            request.resource.data.esQrInterno == true
            && request.resource.data.get('uuidEsperado', null) == null
            && request.resource.data.get('receptorRFCEsperado', null) == null
          )
        );

      // Corrección de la validación 1 (solo supervisor/admin). Si la
      // validación 2 todavía no existía, el embarque sigue esperándola; si
      // ya existía, se re-sincroniza todo de nuevo con el valor corregido.
      allow update: if esSupervisorOAdmin()
        && resource.data.origenEscaneo != null
        && resource.data.get('uuidEsperado', null) != null
        && request.resource.data.embarqueId == resource.data.embarqueId
        && request.resource.data.origenEscaneo.escaneadoPor == resource.data.origenEscaneo.escaneadoPor
        && request.resource.data.uuidEsperado is string
        && request.resource.data.uuidEsperado.size() > 0
        && request.resource.data.receptorRFCEsperado is string
        && request.resource.data.receptorRFCEsperado.size() > 0
        && request.resource.data.estadoSync == (resource.data.get('validacion2', null) == null ? 'esperando_validacion2' : 'pendiente')
        && request.resource.data.origenEscaneo.correccion.por.uid == request.auth.uid
        && request.resource.data.origenEscaneo.correccion.timestamp == request.time
        && request.resource.data.origenEscaneo.correccion.valorAnterior.uuidCfdi == resource.data.uuidEsperado
        && request.resource.data.origenEscaneo.correccion.valorAnterior.rfcReceptor == resource.data.receptorRFCEsperado
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uuidEsperado', 'receptorRFCEsperado', 'origenEscaneo', 'estadoSync']);

      // Validación 2 — alguien de Operaciones vuelve a escanear el mismo
      // CFDI de forma independiente, y en el mismo paso asigna al operador
      // que va a recoger el embarque. Solo se permite una vez (mientras no
      // exista todavía) y solo si la validación 1 ya existe. operadorAsignado
      // es obligatorio (no hay "confirmar sin asignar") y su uid debe
      // corresponder a un operador real y activo del catálogo sincronizado
      // desde Alanis Operadores (operadores_alanis) — así no se puede
      // "inventar" un uid que no existe.
      allow update: if esValidador2()
        && resource.data.origenEscaneo != null
        && resource.data.get('validacion2', null) == null
        && resource.data.get('uuidEsperado', null) != null
        && request.resource.data.embarqueId == resource.data.embarqueId
        && request.resource.data.uuidEsperado == resource.data.uuidEsperado
        && request.resource.data.receptorRFCEsperado == resource.data.receptorRFCEsperado
        && request.resource.data.origenEscaneo == resource.data.origenEscaneo
        && request.resource.data.estadoSync == 'pendiente'
        && request.resource.data.validacion2.escaneadoPor.uid == request.auth.uid
        && request.resource.data.validacion2.timestamp == request.time
        && request.resource.data.validacion2.uuidCoincide == (request.resource.data.validacion2.uuidLeido == resource.data.uuidEsperado)
        && request.resource.data.validacion2.rfcCoincide == (request.resource.data.validacion2.rfcLeido == resource.data.receptorRFCEsperado)
        && request.resource.data.operadorAsignado.uid is string
        && request.resource.data.operadorAsignado.uid.size() > 0
        && exists(/databases/$(database)/documents/operadores_alanis/$(request.resource.data.operadorAsignado.uid))
        && request.resource.data.operadorAsignado.nombre is string
        && request.resource.data.operadorAsignado.asignadoPor == request.auth.uid
        && request.resource.data.operadorAsignado.timestamp == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validacion2', 'estadoSync', 'operadorAsignado']);

      // Validación 2 para embarques SIN FACTURA (2026-09-12, reestructuración
      // del flujo): aquí no hay un CFDI que volver a escanear/comparar — en
      // vez de eso, Operaciones asigna al operador y EN ESE MISMO MOVIMIENTO
      // se generan uuidEsperado/receptorRFCEsperado (el QR de control interno
      // recién creado). A diferencia de la regla de arriba, aquí SÍ se
      // permite que esos dos campos cambien (de no existir a tener el valor
      // del QR generado) — nunca de un valor real a otro.
      allow update: if esValidador2()
        && resource.data.get('esQrInterno', false) == true
        && resource.data.origenEscaneo != null
        && resource.data.get('validacion2', null) == null
        && request.resource.data.embarqueId == resource.data.embarqueId
        && request.resource.data.origenEscaneo == resource.data.origenEscaneo
        && request.resource.data.estadoSync == 'pendiente'
        && request.resource.data.uuidEsperado is string
        && request.resource.data.uuidEsperado.size() > 0
        && request.resource.data.receptorRFCEsperado == 'SIN-FACTURA'
        && request.resource.data.validacion2.escaneadoPor.uid == request.auth.uid
        && request.resource.data.validacion2.timestamp == request.time
        && request.resource.data.validacion2.uuidCoincide == true
        && request.resource.data.validacion2.rfcCoincide == true
        && request.resource.data.operadorAsignado.uid is string
        && request.resource.data.operadorAsignado.uid.size() > 0
        && exists(/databases/$(database)/documents/operadores_alanis/$(request.resource.data.operadorAsignado.uid))
        && request.resource.data.operadorAsignado.nombre is string
        && request.resource.data.operadorAsignado.asignadoPor == request.auth.uid
        && request.resource.data.operadorAsignado.timestamp == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validacion2', 'estadoSync', 'operadorAsignado', 'uuidEsperado', 'receptorRFCEsperado']);

      // Reasignación de operador (2026-09-12, decisión de Ivan): cualquier
      // puesto de Operaciones o admin puede cambiar quién es el
      // operadorAsignado — con o sin factura, sin justificar motivo —
      // mientras la pre-entrega (Checkpoint 2) todavía no se haya
      // completado. verificaciones_cfdi_resultado es donde Alanis
      // Operadores refleja ese resultado (ver esa colección más abajo);
      // mientras no exista, o no traiga VALIDADO/DISCREPANCIA todavía, se
      // puede reasignar cuantas veces haga falta. El operador anterior
      // nunca se pierde: historialReasignaciones solo permite AGREGAR
      // (nunca se le exige que crezca por un tamaño exacto porque el
      // cliente arma el arreglo completo desde el valor leído, igual que ya
      // se hace con validacion2/operadorAsignado arriba).
      allow update: if esValidador2()
        && resource.data.get('operadorAsignado', null) != null
        && !(
          exists(/databases/$(database)/documents/verificaciones_cfdi_resultado/$(embarqueId)) &&
          get(/databases/$(database)/documents/verificaciones_cfdi_resultado/$(embarqueId)).data.get('estatusValidacion', null) in ['VALIDADO', 'DISCREPANCIA']
        )
        && request.resource.data.operadorAsignado.uid is string
        && request.resource.data.operadorAsignado.uid.size() > 0
        && exists(/databases/$(database)/documents/operadores_alanis/$(request.resource.data.operadorAsignado.uid))
        && request.resource.data.operadorAsignado.nombre is string
        && request.resource.data.operadorAsignado.asignadoPor == request.auth.uid
        && request.resource.data.operadorAsignado.timestamp == request.time
        && request.resource.data.historialReasignaciones is list
        // NUEVO (2026-09-13): la reasignación ahora también debe poner
        // estadoSync en 'pendiente' para que la sincronización (Cloud
        // Function o Codigo.gs) recoja el operadorAsignado nuevo.
        && request.resource.data.estadoSync == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['operadorAsignado', 'historialReasignaciones', 'estadoSync']);

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // QR interno para embarques SIN factura (2026-09-10, ver
    // escaneoOrigen.js): cuando McCain no adjunta factura (movimiento
    // interno de inventario, confirmado con McCain en junta), Atención al
    // Cliente genera su propio QR — tras confirmar explícitamente que es
    // un caso legítimo, no un dato faltante por error — que sustituye al
    // QR del CFDI en toda la cadena de escaneo (origen, validación 2,
    // checkpoints del operador). Este doc es la referencia DURABLE de ese
    // QR generado: necesaria porque el QR se imprime y se escanea después,
    // posiblemente desde otro dispositivo o sesión del navegador —
    // guardarlo solo en memoria del navegador (lo que se probó primero) se
    // rompe en cuanto cambia el dispositivo o se recarga la página.
    // create-only a propósito: una vez generado un código para un
    // embarque, no se corrige ni se reemplaza aquí — si hiciera falta uno
    // distinto, es un caso nuevo. rfc siempre es el marcador fijo
    // 'SIN-FACTURA' (ver RFC_MARCADOR_SIN_FACTURA en escaneoOrigen.js), no
    // un RFC real.
    // ------------------------------------------------------------------
    match /qr_internos_generados/{embarqueId} {
      allow read: if usuarioActivoValido();
      // 2026-09-12: antes solo Atención al Cliente (esValidador1) generaba
      // este QR; con la reestructuración del flujo sin factura, ahora es
      // Operaciones (esValidador2) quien lo crea, al asignar operador.
      allow create: if (esValidador1() || esValidador2())
        && request.resource.data.uuid is string
        && request.resource.data.uuid.size() > 0
        && request.resource.data.rfc == 'SIN-FACTURA'
        && request.resource.data.generadoPor.uid == request.auth.uid
        && request.resource.data.timestamp == request.time;

      // Reasignación de operador (2026-09-12): si el embarque sin factura se
      // reasigna ANTES de que el operador anterior haya hecho Checkpoint 1
      // (recepción — reflejado en verificaciones_cfdi_resultado.
      // recepcionResultado), se reimprime el MISMO QR (uuid/rfc/texto NUNCA
      // cambian aquí) solo actualizando el nombre visible en el papel. Si
      // Checkpoint 1 ya se hizo, esta rama ni siquiera se necesita — el
      // cliente no la usa (ver reasignarOperador() en escaneoOrigen.js) —
      // pero igual queda acotada aquí por seguridad, nunca solo del lado del
      // navegador.
      allow update: if esValidador2()
        && !(
          exists(/databases/$(database)/documents/verificaciones_cfdi_resultado/$(embarqueId)) &&
          get(/databases/$(database)/documents/verificaciones_cfdi_resultado/$(embarqueId)).data.get('recepcionResultado', null) != null
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['operadorNombre']);

      allow delete: if false;
    }

    match /verificaciones_cfdi_resultado/{embarqueId} {
      allow read: if usuarioActivoValido();
      allow write: if false;
    }

    match /embarques_pendientes_origen/{embarqueId} {
      allow read: if usuarioActivoValido();
      allow write: if false;
    }

    // Catálogo de operadores de Alanis Operadores (uid, nombre, numero de
    // unidad), sincronizado de solo lectura por el Apps Script cada pocos
    // minutos (nuevo, 2026-09-07) — usado por el selector obligatorio de
    // "operador asignado" en la 2da validación de arriba. Nadie escribe
    // aquí desde el navegador: lo llena el Apps Script con su propia
    // cuenta de servicio, que no pasa por estas reglas.
    match /operadores_alanis/{uid} {
      allow read: if usuarioActivoValido();
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Borrado de prueba — TEMPORAL, solo mientras dure esta fase de
    // pruebas con McCain en pausa (2026-09-08). El botón de admin en
    // ADREMATASA únicamente crea esta solicitud; quien borra de verdad (en
    // los dos proyectos) es el Apps Script, con su propia cuenta de
    // servicio — repositorio_mccain (alanis-operadores) y
    // verificaciones_cfdi_local (aquí) siguen con "allow delete: if false"
    // para cualquier navegador, sin excepción, ni siquiera admin.
    //
    // QUITAR este bloque completo cuando termine la fase de pruebas.
    // ------------------------------------------------------------------
    match /solicitudes_borrado_prueba/{embarqueId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.solicitadoPor == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Reiniciar flujo — SOLO ADMIN (2026-09-14, pedido de Ivan). Regresa un
    // embarque a "recién llegado, sin ningún escaneo" para que Atención al
    // Cliente lo capture de cero — borra origen, 2da validación y operador
    // asignado. Mismo patrón que "Borrado de prueba" arriba: el navegador
    // únicamente crea esta solicitud; quien borra de verdad (en los dos
    // proyectos: repositorio_mccain en alanis-operadores y
    // verificaciones_cfdi_local aquí) es la Cloud Function
    // procesarSolicitudReinicioFlujo, con su propia cuenta de servicio —
    // ninguna de esas dos colecciones permite "delete" a ningún navegador,
    // ni siquiera admin (ver "allow delete: if false" de cada una). A
    // diferencia del borrado de prueba, embarques_pendientes_origen NUNCA se
    // toca — es justo lo que hace que el embarque reaparezca como
    // pendiente para Atención al Cliente.
    // ------------------------------------------------------------------
    match /solicitudes_reinicio_flujo/{embarqueId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.solicitadoPor == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // Bitácora de reinicios de flujo — la llena procesarSolicitudReinicioFlujo
    // (cuenta de servicio) como respaldo de auditoría antes de borrar el
    // documento local; nadie escribe aquí desde el navegador.
    match /historial_reinicios_flujo/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Bitácora de enlaces de respaldo del Checkpoint 1 (2026-10-06) — la llena
    // generarEnlaceCheckpoint (cuenta de servicio); nunca guarda el código del
    // enlace, solo quién lo generó, para quién y cuándo.
    match /historial_enlaces_checkpoint/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Solicitudes de enlace de respaldo (2026-10-08, pedido de Ivan): el
    // enlace ya no se genera "a discreción". Operaciones SOLICITA uno por
    // embarque y checkpoint, un admin lo AUTORIZA (o rechaza) en el mismo
    // renglón, y solo entonces Operaciones puede generarlo. Un admin
    // también puede generarlo directo sin solicitud.
    //
    // Id del documento = "<embarqueId>__<checkpoint>" → una sola solicitud
    // por embarque y checkpoint. La autorización dura 12 h desde resueltoEn
    // (esa cuenta la hace la Cloud Function generarEnlaceCheckpoint, que es
    // quien de verdad la hace cumplir; no hay ningún campo de vencimiento
    // que el navegador pueda falsear). El campo ultimoEnlace y el alta
    // directa de admin los escribe solo la función (Admin SDK).
    // ------------------------------------------------------------------
    match /solicitudes_enlace_checkpoint/{solicitudId} {
      function solicitudNueva() {
        let d = request.resource.data;
        return d.keys().hasOnly(['embarqueId', 'checkpoint', 'estado', 'operadorUid', 'operadorNombre', 'motivo', 'detalle', 'solicitadoPor', 'solicitadoEn'])
          && d.keys().hasAll(['embarqueId', 'checkpoint', 'estado', 'operadorUid', 'operadorNombre', 'motivo', 'detalle', 'solicitadoPor', 'solicitadoEn'])
          && d.estado == 'solicitada'
          && d.embarqueId is string && d.embarqueId.size() > 0
          && d.checkpoint in ['recepcion', 'pre_entrega']
          && solicitudId == d.embarqueId + '__' + d.checkpoint
          && d.operadorUid is string && d.operadorUid.size() > 0
          && d.operadorNombre is string
          // El operador de la solicitud tiene que ser el que de verdad
          // está asignado al embarque ahora mismo.
          && exists(/databases/$(database)/documents/verificaciones_cfdi_local/$(d.embarqueId))
          && get(/databases/$(database)/documents/verificaciones_cfdi_local/$(d.embarqueId)).data.get('operadorAsignado', {}).get('uid', '') == d.operadorUid
          && d.motivo in ['Cámara del teléfono no funciona', 'QR dañado o ilegible', 'Sin señal o datos en el teléfono', 'Otro']
          && d.detalle is string && d.detalle.size() <= 300
          && (d.motivo != 'Otro' || d.detalle.size() > 0)
          && d.solicitadoPor.uid == request.auth.uid
          && d.solicitadoPor.nombre is string
          && d.solicitadoEn == request.time;
      }

      allow read: if esValidador2();

      allow create: if esValidador2() && solicitudNueva();

      allow update: if
        // (a) Volver a solicitar: solo cuando la anterior ya no sirve
        //     (rechazada, venció la autorización de 12 h, o cambió el
        //     operador asignado). Reemplaza el documento completo.
        (
          esValidador2() && solicitudNueva() && (
            resource.data.estado == 'rechazada'
            || resource.data.operadorUid != request.resource.data.operadorUid
            || (
              resource.data.estado == 'autorizada'
              && resource.data.resueltoEn + duration.value(12, 'h') < request.time
            )
          )
        )
        // (b) Resolver (solo admin, solo una solicitud pendiente).
        || (
          usuarioActivoValido() && usuarioActual().rol == 'admin'
          && resource.data.estado == 'solicitada'
          && request.resource.data.estado in ['autorizada', 'rechazada']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'resueltoPor', 'resueltoEn', 'comentarioAdmin', 'verificacionManual'])
          && request.resource.data.resueltoPor.uid == request.auth.uid
          && request.resource.data.resueltoPor.nombre is string
          && request.resource.data.resueltoEn == request.time
          && request.resource.data.get('comentarioAdmin', '') is string
          && request.resource.data.get('comentarioAdmin', '').size() <= 300
          && request.resource.data.get('verificacionManual', false) is bool
          // El Checkpoint 2 solo se autoriza si el admin confirma que
          // verificó la documentación por otro medio.
          && (
            request.resource.data.estado == 'rechazada'
            || resource.data.checkpoint == 'recepcion'
            || request.resource.data.get('verificacionManual', false) == true
          )
        );

      // Cancelar: el que solicitó, mientras siga pendiente; un admin, siempre.
      allow delete: if esAdmin()
        || (esValidador2() && resource.data.estado == 'solicitada' && resource.data.solicitadoPor.uid == request.auth.uid);
    }
  }
}